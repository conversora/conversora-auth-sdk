{
  "name": "conversora-auth-sdk",
  "version": "1.0.0",
  "description": "Universal RFC 9449 DPoP authentication & customer management SDK for Conversora e-commerce storefronts and modern web applications.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.cjs",
      "default": "./dist/react/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx --test test/*.test.ts"
  },
  "keywords": [
    "conversora",
    "conversora-auth",
    "conversora-auth-sdk",
    "authentication",
    "dpop",
    "rfc9449",
    "jwt",
    "ecommerce",
    "astro",
    "react",
    "nextjs",
    "clerk-alternative"
  ],
  "author": "Conversora Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conversora/conversora-auth-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/conversora/conversora-auth-sdk/issues"
  },
  "homepage": "https://github.com/conversora/conversora-auth-sdk#readme",
  "dependencies": {},
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.28.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
